# Copy to .env (same directory as docker-compose.yml) and adjust.

# --- Images / auto-deploy ---------------------------------------------------
# GitHub account (lower-case) that owns the published images. GitHub Actions
# pushes ghcr.io/<owner>/weatherchannel-web and ghcr.io/<owner>/weatherchannel-caster
# on every commit to main. Packages must be Public, or the host must have run
# `docker login ghcr.io` (see deploy/README.md section 1).
GHCR_OWNER=csmaxpower

# Which tag to run. `latest` is what Watchtower tracks; pin to a release tag
# (e.g. v0.1.3) to freeze a deployment or roll back.
IMAGE_TAG=latest

# How often Watchtower checks ghcr.io, in seconds.
WATCHTOWER_POLL_INTERVAL=300

# Watchtower asks for Docker API v1.25, which current daemons refuse. Pin a
# supported version; check with:  docker version --format '{{.Server.APIVersion}}'
DOCKER_API_VERSION=1.44

TZ=America/Chicago

# --- The channel ------------------------------------------------------------
# Location of the 24/7 channel. A ZIP is simplest; anything the app's search
# box accepts works ("Tuscaloosa, AL", an airport name...). Also becomes the
# website's default location for visitors with no query string.
CHANNEL_ZIP=35406

# Optional but recommended: the resolved "lat,lon" for CHANNEL_ZIP. With it the
# kiosk page skips the ArcGIS geocoder on every load and reload, so a geocoder
# outage cannot blank the channel. Get it from the app: search the ZIP, click
# "Copy Permalink" and read the latLon value, or:
#   curl -s "https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer/find?text=35406&f=json" | jq '.locations[0].feature.geometry'
# (y is lat, x is lon). Leave blank to geocode at load time.
CHANNEL_LATLON=33.2699,-87.5173

# Optional extra permalink parameters: which displays are on, units, speed...
# Generate with the app's "Copy Permalink" button and paste everything after
# the "?" except latLonQuery/latLon/kiosk. Leave blank for the app defaults.
CHANNEL_QUERY=

# Channel title shown in the generated IPTV playlist (/playlist.m3u).
CHANNEL_NAME=WeatherStar 4000+

# --- Streaming (ws4kp-caster, `--profile cast`) -----------------------------
# Existing MediaMTX host. Accepts unauthenticated publishes and re-serves the
# feed over RTSP 8554 / RTMP 1935 / HLS 8888 / WebRTC 8889 / SRT 8890.
MEDIAMTX_HOST=10.30.0.54
MEDIAMTX_PATH=weather

# Raw MPEG-TS multicast for IPTV apps and hardware decoders. Convention on this
# network: the group's last octet matches the publishing host (10.30.0.60).
MULTICAST_ADDR=239.10.30.60
MULTICAST_PORT=5004
MULTICAST_TTL=4

# --- Audio ------------------------------------------------------------------
# ffmpeg plays every *.mp3 under MUSIC_DIR as the channel's audio. The image
# bakes in server/music with one subfolder per playlist:
#   /music/default     year-round
#   /music/Christmas   seasonal
# Change MUSIC_DIR and run `docker compose --profile cast up -d` to switch; the
# caster restarts in ~20 s. /music alone would play all folders mixed together.
# MUSIC=0 sends silence. Volume is linear gain, 1.0 = unchanged.
MUSIC=1
MUSIC_DIR=/music/default
MUSIC_VOLUME=1.0
MUSIC_SHUFFLE=1

# --- Capture geometry -------------------------------------------------------
# For 4K output set 3840x2160 AND DEVICE_SCALE=2. The WeatherStar display is a
# 640x480 stage scaled to the viewport, so raising the resolution without the
# scale factor only upscales the same pixels.
WIDTH=1920
HEIGHT=1080
DEVICE_SCALE=1
FRAMERATE=30

# --- Encoder quality --------------------------------------------------------
# PIX_FMT   yuv420p plays on every set-top box and TV app. yuv444p keeps full
#           chroma but needs the High 4:4:4 profile many hardware decoders
#           refuse (the radar channel uses it for its 1px strokes; weather
#           does not need it).
# OUT_RANGE limited (TV range) is what IPTV decoders expect. Set full if blacks
#           look lifted on a PC player. The stream is tagged either way.
# CRF       lower = better. 18 is near-lossless here; raise toward 23 to cut
#           bandwidth.
# PRESET    slower = sharper edges for the same bitrate; affordable because the
#           picture is nearly static.
PIX_FMT=yuv420p
OUT_RANGE=limited
CRF=18
PRESET=slow
VIDEO_BITRATE=8000k
BUFSIZE=16000k

# Keeps B-frames off so MediaMTX WebRTC readers work. Set 0 to reclaim ~15-20%
# bitrate if you never use the WebRTC endpoint.
WEBRTC_COMPAT=1

# --- Page watchdog ----------------------------------------------------------
WATCHDOG_INTERVAL=30
WATCHDOG_STRIKES=2
RECYCLE_INTERVAL=21600
